# Supabase を使う場合のみ設定する (supabase/schema.sql を実行しておくこと)。
# 未設定ならローカルファイル保存モード (.data/fireworks.json + SSE) で動作する。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 公開運用 (トンネル等) 時の管理保護。設定すると /admin と破壊系 API がキー必須になる。
# /admin?key=<この値> を一度開くと Cookie が入り、以後は /admin のままでOK。
# 未設定なら保護なし (会場ローカル運用向け)。
ADMIN_KEY=
